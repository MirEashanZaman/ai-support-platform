# ============================================================================
# AI Support Platform — Environment Configuration Example
# Copy this file to `.env` (and `backend/.env`) and fill in values.
# NEVER commit real secrets to Git.
# ============================================================================

# Application
NODE_ENV=development
PORT=4000
# Set DEMO_MODE=false in production deployments so demo accounts/auto-login are disabled
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true
FRONTEND_URL=http://localhost:3000

# PostgreSQL + pgvector
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=ai_support_platform
# Optional non-superuser role for strict RLS enforcement in runtime queries
DATABASE_RLS_USER=app_tenant_user
DATABASE_RLS_PASSWORD=app_tenant_password

# Redis (Caching, Rate Limiting, WebSocket Adapter)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ (Ingestion Pipeline + Dead-Letter Queue)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_INGESTION_QUEUE=document.ingestion.queue
RABBITMQ_DLQ=document.ingestion.dlq

# JWT Authentication
JWT_ACCESS_SECRET=replace-with-strong-64-char-access-secret-in-production
JWT_REFRESH_SECRET=replace-with-strong-64-char-refresh-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI & Embeddings Providers
# Supported EMBEDDING_PROVIDER values: mock | openai | voyage
EMBEDDING_PROVIDER=mock
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=sk-your-openai-api-key
VOYAGE_API_KEY=pa-your-voyage-api-key

# Anthropic Claude API (RAG Answer Generation)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
RAG_SIMILARITY_THRESHOLD=0.72

